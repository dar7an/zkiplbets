{
  "name": "@zk-cricket/contracts",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts src/__tests__/Bet.test.ts src/__tests__/BetStorage.test.ts src/__tests__/oracle.live.test.ts",
    "test:e2e": "vitest run --config vitest.config.ts src/__tests__/Bet.e2e.test.ts",
    "test:live": "RUN_LIVE_ORACLE=1 vitest run --config vitest.config.ts src/__tests__/oracle.live.test.ts",
    "test:proofs": "RUN_PROOFS=1 vitest run --config vitest.config.ts src/__tests__/Bet.proof.smoke.test.ts",
    "demo": "npm run build && node dist/demo/server.js"
  },
  "dependencies": {
    "@zk-cricket/shared": "*",
    "o1js": "^2.15.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.3",
    "@types/node": "^22.17.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.4"
  }
}
